APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Base URL used to build public ingest endpoints ({INGEST_URL}/ingest/{token}).
# Defaults to APP_URL. Never derived from the request Host header (ADR-006).
# INGEST_URL="${APP_URL}"
# Ingest guards (PLACEHOLDER high defaults — revisit before MVP / public exposure).
# INGEST_MAX_BODY_BYTES=52428800
# INGEST_RATE_LIMIT_PER_MINUTE=6000
# Cap for a proxy's user-defined ingest response body (bytes). Default 8 KiB.
# INGEST_RESPONSE_BODY_MAX_BYTES=8192
# FIFO claim lease duration / orphaned-claim sweep cutoff (seconds). Default 90.
# INGEST_FIFO_LEASE_SECONDS=90
# Dedicated queue name for Async per-destination delivery jobs. Default "webhooks".
# INGEST_WEBHOOKS_QUEUE=webhooks
# Payload retention window (days). Fixed 30-day default; not a per-team lever.
# RETENTION_DAYS=30
# Garbage collector per-team, per-run purge batch size. Default 500.
# RETENTION_PURGE_BATCH=500
# Hold H4 pre-dispatch horizon (minutes). Default 60.
# RETENTION_DISPATCH_HORIZON_MINUTES=60
# System-default delivery attempt limit (product value). Default 5.
# RETRY_DEFAULT_ATTEMPT_LIMIT=5
# Hard cap a per-proxy attempt-limit override is clamped to (product value). Default 10.
# RETRY_MAX_ATTEMPT_LIMIT=10
# Exponential backoff base delay (seconds). Default 60.
# RETRY_EXPONENTIAL_BASE_SECONDS=60
# Exponential backoff growth multiplier. Default 5.
# RETRY_EXPONENTIAL_MULTIPLIER=5
# Exponential backoff per-delay cap (seconds). Default 21600 (6 hours).
# RETRY_EXPONENTIAL_MAX_DELAY_SECONDS=21600
# Fixed backoff interval (seconds). Default 300 (5 minutes).
# RETRY_FIXED_INTERVAL_SECONDS=300
# Sweeper grace period past next_attempt_at before re-driving (seconds). Default 120.
# RETRY_SWEEP_GRACE_SECONDS=120

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon only supervises Redis queues. Leaving this on `database` means
# Horizon runs but shows nothing, because it is watching a queue the
# application never writes to.
QUEUE_CONNECTION=redis

# Must stay above the longest Horizon supervisor timeout in config/horizon.php.
# Below it, Redis re-queues a job the worker is still running and a second
# worker re-sends webhooks the first has already delivered. Unrelated to the
# application's own retry policy, which dispatches delayed RetryDelivery jobs
# rather than releasing them back to the queue.
# REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Credentials the browser prompts for at /horizon. Both are required: with
# either missing or empty the dashboard rejects every request, so an
# unconfigured deployment is locked rather than open. These are deployment
# configuration, not an application account — this project has no superadmin
# role. Basic auth is base64-encoded, not encrypted, so serve it over HTTPS.
HORIZON_USERNAME=
HORIZON_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
